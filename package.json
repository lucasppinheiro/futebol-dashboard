{
  "name": "futebol-dashboard",
  "version": "1.0.0",
  "description": "Interactive Brasileirao Serie A dashboard with Flask, automated data sync, tests, and Vercel deployment.",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest --verbose",
    "test:python": "python -m pytest tests -q",
    "build": "python build_static.py",
    "audit": "npm audit --audit-level=high",
    "lint": "eslint static/js tests/js eslint.config.mjs",
    "lint:fix": "eslint static/js tests/js eslint.config.mjs --fix",
    "format": "prettier --write \"static/js/**/*.js\" \"tests/js/**/*.js\"",
    "format:check": "prettier --check \"static/js/**/*.js\" \"tests/js/**/*.js\""
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/js/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucassgsantos/futebol-dashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lucassgsantos/futebol-dashboard/issues"
  },
  "homepage": "https://futebol-dashboard.vercel.app/",
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.5"
  }
}
