# Fonte dos dados: cbf (padrao) ou football-data
DATA_SOURCE=cbf

# Token da football-data.org. Com a fonte CBF, enriquece o snapshot com calendário e resultados.
# Mantenha apenas no ambiente do servidor ou nos segredos do GitHub; nunca exponha no navegador.
FOOTBALL_DATA_TOKEN=

# Quantas classificacoes historicas ausentes buscar por execucao (1 a 6).
# O padrao 4 reserva chamadas para calendario, rodada atual e contingencias no plano gratuito.
HISTORICO_RODADAS_POR_ATUALIZACAO=4

# Token para proteger a rota POST /api/atualizar (opcional)
API_UPDATE_TOKEN=

# Atualizacao automatica em segundo plano quando o arquivo local estiver desatualizado (0 desliga)
DATA_AUTO_REFRESH_HOURS=6
# Intervalo minimo entre tentativas automaticas, inclusive apos falha
DATA_AUTO_REFRESH_COOLDOWN_MINUTES=15

# Flask
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Prefixo para builds estaticos em subdiretorios, como GitHub Pages de repositorio
SITE_BASE_PATH=

# URL publica usada no sitemap
SITE_ORIGIN=https://futebol-dashboard.vercel.app
